# ==============================================================================
# Production Environment Variable Template
# Copy this file to .env.prod and populate with secure production values
# DO NOT COMMIT THE ACTUAL .env.prod FILE TO VERSION CONTROL
# ==============================================================================

# Application & Environment Settings
APP_NAME=supply-chain-intelligence
ENVIRONMENT=production
LOG_LEVEL=INFO

# Security & API Authentication
# Generate a strong key, e.g. openssl rand -hex 32
API_KEY=sc-key-production-secret-change-me

# PostgreSQL Production Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=supply_chain_prod
POSTGRES_USER=supply_chain_admin
POSTGRES_PASSWORD=replace_with_secure_postgres_password_here
DATABASE_URL=postgresql://supply_chain_admin:replace_with_secure_postgres_password_here@postgres:5432/supply_chain_prod

# Redis Production Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_secure_redis_password_here
REDIS_URL=redis://:replace_with_secure_redis_password_here@redis:6379/0

# MLflow Tracking Configuration
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_ARTIFACT_LOCATION=/mlflow/artifacts

# API Gateway & Dashboard Configuration
API_BASE_URL=http://nginx:80
API_HOST=0.0.0.0
API_PORT=8000
